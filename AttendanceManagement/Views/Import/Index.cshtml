@{
    ViewData["Title"] = "Importation CSV";
}

<div class="container-fluid py-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white fw-bold py-2">
            <i class="bi bi-upload me-2"></i> Importation du fichier Pointage CSV (BioEntry)
        </div>
        <div class="card-body p-4">

            @* AFFICHAGE DES MESSAGES D'ERREUR OU DE SUCCÈS *@
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show fw-semibold" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show fw-semibold" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @* FORMULAIRE D'IMPORTATION (Mila enctype="multipart/form-data" sy asp-action="Upload") *@
            <form asp-controller="Import" asp-action="Upload" method="post" enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label fw-bold text-dark">Choisir le fichier CSV (BioEntry Export) :</label>
                    <!-- Eto ny point lehibe: name="file" mba hitovy amin'ny Upload(IFormFile file) ao amin'ny Controller -->
                    <input type="file" name="file" class="form-control form-control-lg" accept=".csv" required />
                    <div class="form-text text-muted">
                        Sélectionnez le fichier CSV téléchargé depuis la pointeuse BioEntry.
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success fw-bold px-4">
                        <i class="bi bi-upload me-1"></i> Importer les données
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        Voir le Tableau de Bord
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>