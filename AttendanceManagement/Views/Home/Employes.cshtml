@model IEnumerable<AttendanceManagement.Models.Employe>
@{
    ViewData["Title"] = "Liste des Employés";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Liste des Employés</h3>
        <p class="text-muted small m-0">Recherche, consultation et gestion des employés</p>
    </div>
</div>

<!-- BARRE DE RECHERCHE -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Employes" method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0 ps-0" placeholder="Rechercher par Nom ou Matricule..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary fw-bold w-100">Rechercher</button>
                <a asp-action="Employes" class="btn btn-outline-secondary fw-bold">Effacer</a>
            </div>
        </form>
    </div>
</div>

<!-- TABLEAU DES EMPLOYES -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-header bg-dark text-white fw-bold d-flex justify-content-between align-items-center py-2 px-3">
        <span><i class="bi bi-people-fill me-2"></i> Répertoire des Employés</span>
        <span class="badge bg-secondary">Total: @Model.Count() employés</span>
    </div>

    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle m-0" style="font-size: 0.9rem;">
            <thead class="table-light border-bottom">
                <tr>
                    <th class="py-3 ps-4">Matricule & Nom</th>
                    <th class="py-3 text-center">Statut</th>
                    <th class="py-3 text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">
                            <i class="bi bi-search fs-4 d-block mb-1"></i>
                            Aucun employé trouvé pour cette recherche.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">
                                <span class="text-primary me-1">@emp.Matricule</span> (@emp.Nom)
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">OK</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <!-- Bouton Voir le pointage -->
                                    <a asp-action="VoirPointage" asp-route-employeId="@emp.Id" class="btn btn-info text-white btn-sm fw-bold px-3">
                                        <i class="bi bi-eye me-1"></i> Voir le pointage
                                    </a>

                                    <!-- Bouton Supprimer L'employé -->
                                    <form asp-action="SupprimerEmploye" asp-route-id="@emp.Id" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet employé (@emp.Matricule - @emp.Nom) et TOUS ses pointages ?');" style="display:inline;">
                                        <button type="submit" class="btn btn-outline-danger btn-sm fw-bold px-3">
                                            <i class="bi bi-trash3-fill me-1"></i> Supprimer
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>