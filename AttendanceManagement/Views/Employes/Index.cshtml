@model IEnumerable<AttendanceManagement.Models.Employe>
@{
    ViewData["Title"] = "Gestion des Employés";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Liste des Employés</h3>
        <p class="text-muted small m-0">Consultez les heures et les historiques de pointage par employé</p>
    </div>
</div>

<!-- BARRE DE RECHERCHE -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-10">
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Rechercher par matricule ou nom..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">
                    <i class="bi bi-search me-1"></i> Rechercher
                </button>
            </div>
        </form>
    </div>
</div>

<!-- TABLEAU DES EMPLOYÉS -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover table-striped align-middle m-0">
            <thead class="table-dark">
                <tr>
                    <th class="py-3 ps-4">Matricule</th>
                    <th class="py-3">Nom & Prénom</th>
                    <th class="py-3 text-center">Total Pointages</th>
                    <th class="py-3 text-center pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">Aucun employé trouvé.</td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in Model)
                    {
                        var nbPointages = emp.Pointages?.Count ?? 0;
                        <tr>
                            <td class="ps-4 fw-bold text-primary">@emp.Matricule</td>
                            <td class="fw-bold text-dark">@emp.Nom</td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark fw-bold px-3 py-2">
                                    @nbPointages pointages
                                </span>
                            </td>
                            <td class="text-center pe-4">
                                @if (emp.Pointages != null && emp.Pointages.Any())
                                {
                                    var derniereDate = emp.Pointages.OrderByDescending(p => p.DatePointage).First().DatePointage;
                                    <a asp-controller="Home" asp-action="VoirPointage" asp-route-employeId="@emp.Id" asp-route-date="@derniereDate.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-primary fw-bold px-3">
                                        Voir les heures
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>